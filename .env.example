# ============================================
# 复制本文件为 .env，把值换成自己的真实密钥
# .env 已在 .gitignore 中，不会被提交到 GitHub
# ============================================

# ---- Supabase（Project Settings -> API）----
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# ---- 大模型密钥（用哪个填哪个，不用的可以留空）----
# 豆包 / 火山方舟：https://console.volcengine.com/ark
DOUBAO_API_KEY=
# 必填。填「推理接入点 ID」（形如 ep-2026xxxx-xxxxx），
# 或直接填模型 ID（形如 doubao-seed-1-6-250615，方舟 v3 支持直调）
DOUBAO_MODEL=
# 可选。方舟兼容地址，默认 https://ark.cn-beijing.volces.com/api/v3
DOUBAO_BASE_URL=

# DeepSeek：https://platform.deepseek.com
DEEPSEEK_API_KEY=

# 通义千问 DashScope：https://dashscope.console.aliyun.com
QWEN_API_KEY=

# Kimi 月之暗面：https://platform.moonshot.cn
KIMI_API_KEY=
